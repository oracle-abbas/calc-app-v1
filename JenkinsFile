pipeline {
    agent any



    stages {
        stage('Checkout') {
            steps {
                git branch:'main',
                url:'https://github.com/oracle-abbas/calc-app-v1.git'

            }
        }
        stage('Build') {
            steps {
               https://github.com/oracle-abbas/calc-app-v1.git
               bat 'mvn compile'
            }
        }
        stage('Testing') {
            steps {
               bat 'mvn test'
            }
        }
        stage('package') {
            steps {
               bat 'mvn  package'
            }
        }
    }
    post{
        success{
            echo "Build completed successfully"
        }
        failure{
            echo "Build Failed!"
        }
    }
}
